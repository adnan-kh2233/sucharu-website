PORT=5000
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@sucharu.local
ADMIN_PASSWORD=replace-with-a-unique-14-character-or-longer-password
CLIENT_URL=http://127.0.0.1:5500,http://localhost:5500
FIREBASE_PROJECT_ID=sucharu-87667
# Private local Firebase Admin service-account JSON is required for Firestore access.
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\ASUS\AppData\Local\SucharuSecrets\firebase-admin.json
# Keep existing API customer sessions until the web and Android clients consume Firebase custom-token sessions.
CUSTOMER_AUTH_MODE=legacy
# SMTP is required for customer email password-reset codes. Use a provider app password/API SMTP credential.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@example.com
SMTP_PASS=replace-with-provider-app-password
SMTP_FROM=Sucharu <your-sender@example.com>
# Never commit or share the service-account file.
